rules_version = '2';
service cloud.firestore {
match /databases/{database}/documents {

// --- Helper functions ---

function isAuthed() {
return request.auth != null;
}

function isOwner(userId) {
return isAuthed() && request.auth.uid == userId;
}

function notChangingOwner() {
return !('uid' in request.resource.data) ||
request.resource.data.uid == request.auth.uid;
}

// Client is not touching oauthTokens on this write. Tokens are now
// written and refreshed exclusively server-side (Admin SDK) via
// oauth-token.js and the daily refresh sweep, encrypted at rest in
// the oauth_tokens subcollection below -- this field is now frozen
// from the client.
function notTouchingOauthTokens() {
return !('oauthTokens' in request.resource.data.diff(resource.data).affectedKeys());
}

// --- User profiles ---
// /users/{uid}
match /users/{userId} {
allow read: if isOwner(userId);
allow create: if isOwner(userId) && notChangingOwner() && notTouchingOauthTokens();
allow update: if isOwner(userId) && notChangingOwner() && notTouchingOauthTokens();
allow delete: if false;

// --- Jobs subcollection ---
// /users/{uid}/jobs/{jobId}
match /jobs/{jobId} {
allow read: if isOwner(userId);
allow write: if false;
}

// --- OAuth tokens subcollection ---
// /users/{uid}/oauth_tokens/{provider}   (provider: "quickbooks" | "zoho")
// Encrypted access/refresh tokens, written and refreshed exclusively by
// Netlify Functions using the Admin SDK. Never readable or writable from
// the client under any condition.
match /oauth_tokens/{provider} {
allow read, write: if false;
}
}

// --- Deny everything else ---
match /{document=**} {
allow read, write: if false;
}
}
}
