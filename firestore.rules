rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────

    function isAuthed() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthed() && request.auth.uid == userId;
    }

    function notChangingOwner() {
      return !('uid' in request.resource.data) ||
             request.resource.data.uid == request.auth.uid;
    }

    // oauthTokens field is frozen from the client — written only by Admin SDK
    function notTouchingOauthTokens() {
      return !('oauthTokens' in request.resource.data.diff(resource.data).affectedKeys());
    }

    // Prevent clients from elevating their own plan or subscription status
    function notTouchingBilling() {
      let billingFields = ['plan', 'subscriptionStatus', 'stripeCustomerId',
                           'stripeSubscriptionId', 'planActivatedAt', 'planUpdatedAt',
                           'trialEnd'];
      return !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(billingFields);
    }

    // ── User profiles  /users/{uid} ───────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isOwner(userId);
      allow create: if isOwner(userId) && notChangingOwner()
                       && notTouchingOauthTokens() && notTouchingBilling();
      allow update: if isOwner(userId) && notChangingOwner()
                       && notTouchingOauthTokens() && notTouchingBilling();
      allow delete: if false;

      // ── Invoices  /users/{uid}/invoices/{invoiceId} ───────────────────────
      // Created by Netlify Functions (Admin SDK) via SMS dispatch.
      // Dashboard reads and can update status (e.g. mark paid).
      match /invoices/{invoiceId} {
        allow read:   if isOwner(userId);
        allow create: if isOwner(userId);        // allow web-portal invoice creation
        allow update: if isOwner(userId);        // allow status/note updates
        allow delete: if false;
      }

      // ── Jobs  /users/{uid}/jobs/{jobId} ──────────────────────────────────
      // Created and updated by Admin SDK only. Dashboard read-only.
      match /jobs/{jobId} {
        allow read:         if isOwner(userId);
        allow create,
              update,
              delete:       if false;
      }

      // ── Dispatch  /users/{uid}/dispatch/{docId} ───────────────────────────
      // Managed by Admin SDK. Dashboard read-only.
      match /dispatch/{docId} {
        allow read:         if isOwner(userId);
        allow create,
              update,
              delete:       if false;
      }

      // ── Customers  /users/{uid}/customers/{customerId} ────────────────────
      // Created and managed from the portal by the account owner.
      match /customers/{customerId} {
        allow read:   if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // ── Monthly usage counters  /users/{uid}/docCounts/{YYYY-MM} ─────────
      // REGRESSION FIX: this subcollection had no rule, so it fell through to
      // the deny-all below. loadUserData() reads it in a Promise.all alongside
      // the profile, invoices and customers, so the denied read rejected the
      // whole batch, the catch fell back to plan:'unpaid', and every signed-in
      // user was sent to the locked screen — locked out of a paid account.
      //
      // Writes are constrained so the counter can only move forward: a new
      // month starts at 1 and an existing month may only increment by exactly 1.
      // Without that a client could reset its own count to 0 and bypass the
      // plan limit entirely.
      match /docCounts/{monthKey} {
        allow read:   if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.count == 1;
        allow update: if isOwner(userId)
                         && request.resource.data.count == resource.data.count + 1;
        allow delete: if false;
      }

      // ── OAuth tokens  /users/{uid}/oauth_tokens/{provider} ────────────────
      // Encrypted tokens. Never readable or writable from the client.
      match /oauth_tokens/{provider} {
        allow read, write: if false;
      }
    }

    // ── Public document viewer  /publicDocs/{docId} ──────────────────────────
    // REGRESSION FIX: this top-level collection had no rule and fell through to
    // the deny-all, which broke BOTH creating a document (the write) and opening
    // a share link in doc.html (the read).
    //
    // Reads are intentionally public: these are the share links a contractor
    // sends to their customer, opened by someone who is not signed in. Only the
    // presentation copy lives here - never oauth tokens, billing fields or
    // anything from the parent user document.
    //
    // Writes are scoped to the owner via the uid stamped at creation. Documents
    // created before that stamp existed carry no uid and are therefore
    // read-only, which is correct for a display copy.
    match /publicDocs/{docId} {
      allow read:   if true;
      allow create: if isAuthed() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthed() && resource.data.uid == request.auth.uid
                       && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // ── Deny everything else ─────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
