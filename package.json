{
  "name": "relay-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Relay - dispatch portal (Pryor Digital Ventures LLC)",
  "engines": {
    "node": "18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@netlify/aws-lambda-compat": "^1.0.0",
    "firebase-admin": "^11.11.1",
    "stripe": "^14.25.0",
    "twilio": "^5.3.0"
  },
  "scripts": {
    "build": "true",
    "backup:list": "cd relay-pwa/functions && node ../../scripts/firestore-restore.mjs --list",
    "backup:pull": "cd relay-pwa/functions && node ../../scripts/firestore-restore.mjs --pull --out ../../backup-latest.json",
    "backup:restore": "cd relay-pwa/functions && node ../../scripts/firestore-restore.mjs --restore",
    "test:backup": "cd relay-pwa/functions && node ../../scripts/test-firestore-backup.mjs"
  },
  "devDependencies": {
    "@netlify/zip-it-and-ship-it": "^15.5.0"
  },
  "author": "Pryor Digital Ventures LLC <support@portal-relay.com>",
  "license": "UNLICENSED"
}
